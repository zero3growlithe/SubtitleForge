<Window x:Class="SubtitleForge.StyleProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SubtitleForge.Controls"
        Title="Text style profile"
        Height="900"
        Width="940"
        MinHeight="620"
        MinWidth="780"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Profile picker -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Profile" Style="{StaticResource SectionLabelStyle}" />
            <ComboBox x:Name="ProfileCombo" Grid.Column="1" SelectionChanged="ProfileSelectionChanged" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="New" MinWidth="0" Padding="10,4" Click="NewProfileClick" />
                <Button Content="Delete" MinWidth="0" Padding="10,4" Click="DeleteProfileClick" />
                <Button x:Name="DefaultButton" Content="Set as default" MinWidth="0" Padding="10,4" Click="SetDefaultClick" />
            </StackPanel>
        </Grid>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Name" Style="{StaticResource SectionLabelStyle}" />
                    <TextBox x:Name="NameBox" Grid.Column="1" Margin="0,0,10,0" LostFocus="BasicsChanged" />

                    <TextBlock Grid.Column="2" Text="Font" Style="{StaticResource SectionLabelStyle}" />
                    <ComboBox x:Name="FontCombo" Grid.Column="3" Width="190" Margin="0,0,10,0" SelectionChanged="BasicsChanged" />
                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                        <CheckBox x:Name="BoldCheck" Content="Bold" Margin="0,0,10,0" Click="BasicsChanged" />
                        <CheckBox x:Name="ItalicCheck" Content="Italic" Margin="0,0,10,0" Click="BasicsChanged" />
                    </StackPanel>
                </Grid>

                <WrapPanel Margin="0,8,0,0">
                    <TextBlock Text="Font size" Style="{StaticResource SectionLabelStyle}" />
                    <controls:NumericDragBox x:Name="FontSizeBox"
                                            Width="64"
                                            Margin="0,0,14,0"
                                            Minimum="6"
                                            Maximum="400"
                                            DragStep="0.25"
                                            Format="0.#"
                                            ToolTip="Drag left and right to scrub the size, or click to type it"
                                            ValueChanged="BasicsChanged" />
                    <TextBlock Text="Words on screen (0 = whole cue)" Style="{StaticResource SectionLabelStyle}" />
                    <controls:NumericDragBox x:Name="WordsBox"
                                            Width="56"
                                            Margin="0,0,14,0"
                                            Minimum="0"
                                            Maximum="40"
                                            DragStep="1"
                                            Format="0"
                                            ToolTip="0 shows the whole cue, 1 shows one word at a time"
                                            ValueChanged="BasicsChanged" />
                    <TextBlock Text="Opacity" Style="{StaticResource SectionLabelStyle}" />
                    <controls:NumericDragBox x:Name="OpacityBox"
                                            Width="56"
                                            Minimum="0"
                                            Maximum="1"
                                            DragStep="0.01"
                                            Format="0.##"
                                            ValueChanged="BasicsChanged" />
                </WrapPanel>

                <WrapPanel Margin="0,8,0,0">
                    <TextBlock Text="Character spacing" Style="{StaticResource SectionLabelStyle}" />
                    <controls:NumericDragBox x:Name="CharacterSpacingBox"
                                            Width="64"
                                            Margin="0,0,14,0"
                                            Minimum="-40"
                                            Maximum="200"
                                            DragStep="0.25"
                                            Format="0.#"
                                            ToolTip="Extra gap after every character, in design pixels. Negative values tighten the text."
                                            ValueChanged="BasicsChanged" />
                    <TextBlock Text="Word spacing" Style="{StaticResource SectionLabelStyle}" />
                    <controls:NumericDragBox x:Name="WordSpacingBox"
                                            Width="64"
                                            Minimum="-40"
                                            Maximum="200"
                                            DragStep="0.25"
                                            Format="0.#"
                                            ToolTip="Extra gap between words, on top of the character spacing"
                                            ValueChanged="BasicsChanged" />
                </WrapPanel>

                <TextBlock Text="Fill" FontWeight="SemiBold" Margin="0,14,0,4" />
                <controls:ColorSpecPicker x:Name="FillPicker" ValueChanged="FillChanged" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <CheckBox x:Name="HighlightCheck" Content="Highlight the word being spoken" Click="BasicsChanged" />
                    <TextBlock Text="Highlight" Style="{StaticResource SectionLabelStyle}" Margin="16,0,6,0" />
                    <controls:ColorSpecPicker x:Name="HighlightPicker" ValueChanged="FillChanged" />
                </StackPanel>

                <!-- Outlines -->
                <TextBlock Text="Outlines (painted in list order, bottom to top)" FontWeight="SemiBold" Margin="0,16,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <ListBox x:Name="OutlineList"
                                 Height="112"
                                 SelectionChanged="OutlineSelectionChanged"
                                 PreviewKeyDown="StackPreviewKeyDown" />
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="Add" MinWidth="0" Padding="10,4" Click="AddOutlineClick" />
                            <Button Content="Copy" MinWidth="0" Padding="10,4" Click="CopyOutlineClick" />
                            <Button Content="Remove" MinWidth="0" Padding="10,4" Click="RemoveOutlineClick" />
                            <Button x:Name="OutlineUpButton"
                                    Content="&#x25B2;"
                                    MinWidth="0"
                                    Padding="0"
                                    Width="26"
                                    ToolTip="Paint this outline earlier (closer to the glyphs) — Ctrl+Up"
                                    Click="MoveOutlineUpClick" />
                            <Button x:Name="OutlineDownButton"
                                    Content="&#x25BC;"
                                    MinWidth="0"
                                    Padding="0"
                                    Width="26"
                                    ToolTip="Paint this outline later (further out) — Ctrl+Down"
                                    Click="MoveOutlineDownClick" />
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <WrapPanel>
                            <TextBlock Text="Name" Style="{StaticResource SectionLabelStyle}" />
                            <TextBox x:Name="OutlineNameBox" Width="112" Margin="0,0,10,0" LostFocus="OutlineFieldChanged" />
                            <CheckBox x:Name="OutlineEnabledCheck" Content="On" Margin="0,0,10,0" Click="OutlineFieldChanged" />
                            <TextBlock Text="Applies to" Style="{StaticResource SectionLabelStyle}" />
                            <ComboBox x:Name="OutlineTargetCombo" Width="118" SelectionChanged="OutlineFieldChanged">
                                <ComboBoxItem Content="Font" Tag="Font" />
                                <ComboBoxItem Content="Composition" Tag="Composition" />
                            </ComboBox>
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBlock Text="Thickness" Style="{StaticResource SectionLabelStyle}" />
                            <controls:NumericDragBox x:Name="OutlineThicknessBox"
                                                     Width="56"
                                                     Margin="0,0,10,0"
                                                     Minimum="-40"
                                                     Maximum="40"
                                                     DragStep="0.1"
                                                     Format="0.#"
                                                     ToolTip="Negative values render the outline to the inside"
                                                     ValueChanged="OutlineFieldChanged" />
                            <TextBlock Text="Offset X" Style="{StaticResource SectionLabelStyle}" />
                            <controls:NumericDragBox x:Name="OutlineOffsetXBox"
                                                     Width="56"
                                                     Margin="0,0,10,0"
                                                     Minimum="-200"
                                                     Maximum="200"
                                                     DragStep="0.5"
                                                     Format="0.#"
                                                     ValueChanged="OutlineFieldChanged" />
                            <TextBlock Text="Offset Y" Style="{StaticResource SectionLabelStyle}" />
                            <controls:NumericDragBox x:Name="OutlineOffsetYBox"
                                                     Width="56"
                                                     Minimum="-200"
                                                     Maximum="200"
                                                     DragStep="0.5"
                                                     Format="0.#"
                                                     ValueChanged="OutlineFieldChanged" />
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <CheckBox x:Name="OutlineInsideCheck"
                                      Content="Inside the glyph"
                                      Margin="0,0,14,0"
                                      ToolTip="Draws the outline on the inside edge instead of around the outside (a negative thickness does the same)"
                                      Click="OutlineFieldChanged" />
                            <CheckBox x:Name="OutlineFilledCheck"
                                      Content="Fill the glyph"
                                      ToolTip="Also fills the glyph with the outline colour, as a base layer under the fill"
                                      Click="OutlineFieldChanged" />
                        </WrapPanel>
                        <controls:ColorSpecPicker x:Name="OutlineColorPicker" Margin="0,6,0,0" ValueChanged="OutlineColorChanged" />
                    </StackPanel>
                </Grid>

                <!-- Shadows -->
                <TextBlock Text="Shadows (painted in list order, bottom to top)" FontWeight="SemiBold" Margin="0,16,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <ListBox x:Name="ShadowList"
                                 Height="112"
                                 SelectionChanged="ShadowSelectionChanged"
                                 PreviewKeyDown="StackPreviewKeyDown" />
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="Add" MinWidth="0" Padding="10,4" Click="AddShadowClick" />
                            <Button Content="Copy" MinWidth="0" Padding="10,4" Click="CopyShadowClick" />
                            <Button Content="Remove" MinWidth="0" Padding="10,4" Click="RemoveShadowClick" />
                            <Button x:Name="ShadowUpButton"
                                    Content="&#x25B2;"
                                    MinWidth="0"
                                    Padding="0"
                                    Width="26"
                                    ToolTip="Paint this shadow earlier (closer to the glyphs) — Ctrl+Up"
                                    Click="MoveShadowUpClick" />
                            <Button x:Name="ShadowDownButton"
                                    Content="&#x25BC;"
                                    MinWidth="0"
                                    Padding="0"
                                    Width="26"
                                    ToolTip="Paint this shadow later (further out) — Ctrl+Down"
                                    Click="MoveShadowDownClick" />
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <WrapPanel>
                            <TextBlock Text="Name" Style="{StaticResource SectionLabelStyle}" />
                            <TextBox x:Name="ShadowNameBox" Width="112" Margin="0,0,10,0" LostFocus="ShadowFieldChanged" />
                            <CheckBox x:Name="ShadowEnabledCheck" Content="On" Margin="0,0,10,0" Click="ShadowFieldChanged" />
                            <TextBlock Text="Applies to" Style="{StaticResource SectionLabelStyle}" />
                            <ComboBox x:Name="ShadowTargetCombo" Width="118" SelectionChanged="ShadowFieldChanged">
                                <ComboBoxItem Content="Font" Tag="Font" />
                                <ComboBoxItem Content="Composition" Tag="Composition" />
                            </ComboBox>
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBlock Text="Thickness" Style="{StaticResource SectionLabelStyle}" />
                            <controls:NumericDragBox x:Name="ShadowThicknessBox"
                                                     Width="56"
                                                     Margin="0,0,10,0"
                                                     Minimum="0"
                                                     Maximum="60"
                                                     DragStep="0.1"
                                                     Format="0.#"
                                                     ValueChanged="ShadowFieldChanged" />
                            <TextBlock Text="Offset X" Style="{StaticResource SectionLabelStyle}" />
                            <controls:NumericDragBox x:Name="ShadowOffsetXBox"
                                                     Width="56"
                                                     Margin="0,0,10,0"
                                                     Minimum="-200"
                                                     Maximum="200"
                                                     DragStep="0.5"
                                                     Format="0.#"
                                                     ValueChanged="ShadowFieldChanged" />
                            <TextBlock Text="Offset Y" Style="{StaticResource SectionLabelStyle}" />
                            <controls:NumericDragBox x:Name="ShadowOffsetYBox"
                                                     Width="56"
                                                     Margin="0,0,10,0"
                                                     Minimum="-200"
                                                     Maximum="200"
                                                     DragStep="0.5"
                                                     Format="0.#"
                                                     ValueChanged="ShadowFieldChanged" />
                            <TextBlock Text="Opacity" Style="{StaticResource SectionLabelStyle}" />
                            <controls:NumericDragBox x:Name="ShadowOpacityBox"
                                                     Width="56"
                                                     Minimum="0"
                                                     Maximum="1"
                                                     DragStep="0.01"
                                                     Format="0.##"
                                                     ValueChanged="ShadowFieldChanged" />
                        </WrapPanel>
                        <controls:ColorSpecPicker x:Name="ShadowColorPicker" Margin="0,6,0,0" ValueChanged="ShadowColorChanged" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Preview -->
<Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                <TextBlock Text="Preview size" Style="{StaticResource SectionLabelStyle}" />
                <controls:NumericDragBox x:Name="PreviewSizeBox"
                                         Width="64"
                                         Margin="0,0,8,0"
                                         Minimum="8"
                                         Maximum="400"
                                         DragStep="0.5"
                                         Format="0.#"
                                         ToolTip="Font size used by this preview only — it never touches the profile"
                                         ValueChanged="PreviewSizeChanged" />
                <TextBlock Text="used by the preview only; the profile keeps its own font size"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SubtleTextBrush}" />
            </WrapPanel>

            <Border Grid.Row="1" Height="250" Background="#FF14141A" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                <Grid>
                    <controls:SubtitleOverlay x:Name="PreviewOverlay" IsHitTestVisible="False" />
                    <TextBlock Text="Live preview — Sample Text"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Margin="8"
                               FontSize="11"
                               Foreground="{StaticResource SubtleTextBrush}" />
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" MinWidth="90" IsCancel="True" Click="CancelClick" />
            <Button Content="Save profile" MinWidth="120" IsDefault="True" Style="{StaticResource AccentButtonStyle}" Click="SaveClick" />
        </StackPanel>
    </Grid>
</Window>
