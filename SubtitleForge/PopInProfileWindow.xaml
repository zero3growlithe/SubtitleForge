<Window x:Class="SubtitleForge.PopInProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SubtitleForge.Controls"
        Title="Pop-in animation profile"
        Height="680"
        Width="860"
        MinHeight="540"
        MinWidth="720"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Profile" Style="{StaticResource SectionLabelStyle}" />
            <ComboBox x:Name="ProfileCombo" Grid.Column="1" SelectionChanged="ProfileSelectionChanged" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="New" MinWidth="0" Padding="10,4" Click="NewProfileClick" />
                <Button Content="Delete" MinWidth="0" Padding="10,4" Click="DeleteProfileClick" />
                <Button x:Name="DefaultButton" Content="Set as default" MinWidth="0" Padding="10,4" Click="SetDefaultClick" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="Name" Style="{StaticResource SectionLabelStyle}" />
                    <TextBox x:Name="NameBox" Width="180" Margin="0,0,16,0" LostFocus="FieldChanged" />
                    <TextBlock Text="Kind" Style="{StaticResource SectionLabelStyle}" />
                    <ComboBox x:Name="KindCombo" Width="140" Margin="0,0,16,0" SelectionChanged="FieldChanged">
                        <ComboBoxItem Content="None" Tag="None" />
                        <ComboBoxItem Content="Slide in" Tag="SlideIn" />
                        <ComboBoxItem Content="Scale in (jelly)" Tag="ScaleIn" />
                        <ComboBoxItem Content="Fade in" Tag="FadeIn" />
                    </ComboBox>
                    <TextBlock Text="Direction" Style="{StaticResource SectionLabelStyle}" />
                    <ComboBox x:Name="DirectionCombo" Width="110" SelectionChanged="FieldChanged">
                        <ComboBoxItem Content="Bottom" Tag="Bottom" />
                        <ComboBoxItem Content="Top" Tag="Top" />
                        <ComboBoxItem Content="Left" Tag="Left" />
                        <ComboBoxItem Content="Right" Tag="Right" />
                    </ComboBox>
                </WrapPanel>

                <WrapPanel Margin="0,10,0,0">
                    <TextBlock Text="Duration (s)" Style="{StaticResource SectionLabelStyle}" />
                    <controls:NumericDragBox x:Name="DurationBox"
                                             Width="62"
                                             Margin="0,0,16,0"
                                             Minimum="0.02"
                                             Maximum="5"
                                             DragStep="0.005"
                                             Format="0.###"
                                             ValueChanged="FieldChanged" />
                    <CheckBox x:Name="PerCharacterCheck"
                              Content="Stagger the entrance"
                              Margin="0,0,10,0"
                              Click="FieldChanged" />
                    <TextBlock Text="per" Style="{StaticResource SectionLabelStyle}" />
                    <ComboBox x:Name="StaggerGroupingCombo"
                              Width="124"
                              Height="24"
                              Margin="0,0,16,0"
                              SelectionChanged="FieldChanged"
                              ToolTip="Character = one glyph after another, word = whole words appear in turn, cue = everything at once">
                        <ComboBoxItem Content="character" Tag="Character" />
                        <ComboBoxItem Content="word" Tag="Word" />
                        <ComboBoxItem Content="whole cue" Tag="Cue" />
                    </ComboBox>
                    <TextBlock Text="Delay (s)" Style="{StaticResource SectionLabelStyle}" />
                    <controls:NumericDragBox x:Name="CharacterDelayBox"
                                             Width="62"
                                             Minimum="0"
                                             Maximum="1"
                                             DragStep="0.002"
                                             Format="0.###"
                                             ValueChanged="FieldChanged" />
                </WrapPanel>

                <TextBlock Text="Slide spring" FontWeight="SemiBold" Margin="0,16,0,4" />
                <WrapPanel>
                    <TextBlock Text="Distance (× font size)" Style="{StaticResource SectionLabelStyle}" />
                    <controls:NumericDragBox x:Name="DistanceBox"
                                             Width="62"
Margin="0,0,16,0" ValueChanged="FieldChanged"
                                             Minimum="-6"
                                             Maximum="6"
                                             DragStep="0.01"
                                             Format="0.###" />
                    <TextBlock Text="Stiffness" Style="{StaticResource SectionLabelStyle}" />
                    <controls:NumericDragBox x:Name="StiffnessBox"
                                             Width="62"
Margin="0,0,16,0" ValueChanged="FieldChanged"
                                             Minimum="0.5"
                                             Maximum="60"
                                             DragStep="0.05"
                                             Format="0.##" />
                    <TextBlock Text="Damping" Style="{StaticResource SectionLabelStyle}" />
                    <controls:NumericDragBox x:Name="DampingBox"
                                             Width="62"
ValueChanged="FieldChanged"
                                             Minimum="0.05"
                                             Maximum="3"
                                             DragStep="0.005"
                                             Format="0.##" />
                </WrapPanel>
                <TextBlock Text="Lower damping bounces more; stiffness decides how fast it snaps into place."
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource SubtleTextBrush}"
                           Margin="0,4,0,0" />

                <TextBlock Text="Scale-in jelly" FontWeight="SemiBold" Margin="0,16,0,4" />
                <WrapPanel>
                    <TextBlock Text="Amplitude X" Style="{StaticResource SectionLabelStyle}" />
                    <controls:NumericDragBox x:Name="JellyXBox"
                                             Width="62"
Margin="0,0,16,0" ValueChanged="FieldChanged"
                                             Minimum="0"
                                             Maximum="3"
                                             DragStep="0.005"
                                             Format="0.###" />
                    <TextBlock Text="Amplitude Y" Style="{StaticResource SectionLabelStyle}" />
                    <controls:NumericDragBox x:Name="JellyYBox"
                                             Width="62"
Margin="0,0,16,0" ValueChanged="FieldChanged"
                                             Minimum="0"
                                             Maximum="3"
                                             DragStep="0.005"
                                             Format="0.###" />
                    <TextBlock Text="Frequency" Style="{StaticResource SectionLabelStyle}" />
                    <controls:NumericDragBox x:Name="JellyFrequencyBox"
                                             Width="62"
Margin="0,0,16,0" ValueChanged="FieldChanged"
                                             Minimum="0"
                                             Maximum="20"
                                             DragStep="0.02"
                                             Format="0.##" />
                    <TextBlock Text="Falloff" Style="{StaticResource SectionLabelStyle}" />
                    <controls:NumericDragBox x:Name="JellyFalloffBox"
                                             Width="62"
ValueChanged="FieldChanged"
                                             Minimum="0"
                                             Maximum="20"
                                             DragStep="0.02"
                                             Format="0.##" />
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

<Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                <TextBlock Text="Preview size" Style="{StaticResource SectionLabelStyle}" />
                <controls:NumericDragBox x:Name="PreviewSizeBox"
                                         Width="64"
                                         Margin="0,0,8,0"
                                         Minimum="8"
                                         Maximum="400"
                                         DragStep="0.5"
                                         Format="0.#"
                                         ToolTip="Font size used by this preview only — it never touches the profile"
                                         ValueChanged="PreviewSizeChanged" />
                <TextBlock Text="used by the preview only; the profile keeps its own font size"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SubtleTextBrush}" />
            </WrapPanel>

            <Border Grid.Row="1" Height="250" Background="#FF14141A" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                <controls:SubtitleOverlay x:Name="PreviewOverlay" IsHitTestVisible="False" />
            </Border>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" MinWidth="90" IsCancel="True" Click="CancelClick" />
            <Button Content="Save profile" MinWidth="120" IsDefault="True" Style="{StaticResource AccentButtonStyle}" Click="SaveClick" />
        </StackPanel>
    </Grid>
</Window>
