<Window x:Class="SubtitleForge.GpuDiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GPU diagnostics"
        Height="540"
        Width="820"
        MinHeight="360"
        MinWidth="560"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="SummaryText"
                   Grid.Row="0"
                   TextWrapping="Wrap"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10" />

        <TextBox x:Name="ReportBox"
                 Grid.Row="1"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas"
                 FontSize="11"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="FixLayoutButton"
                    Content="Move runtime to runtimes\cuda12"
                    MinWidth="0"
                    Padding="12,4"
                    Margin="0,0,8,0"
                    Click="FixLayoutClick"
                    ToolTip="Move ggml-cuda-whisper.dll into runtimes\cuda12\win-x64 and copy the CPU companions next to it" />
            <Button Content="Copy" MinWidth="0" Padding="12,4" Click="CopyClick" />
            <Button Content="Open log folder" MinWidth="0" Padding="12,4" Margin="8,0,0,0" Click="OpenFolderClick" />
            <Button Content="Close" MinWidth="90" Margin="8,0,0,0" IsDefault="True" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
