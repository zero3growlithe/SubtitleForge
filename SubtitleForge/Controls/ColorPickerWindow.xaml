<Window x:Class="SubtitleForge.Controls.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick a colour"
        Height="466"
        Width="392"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Saturation / value square -->
        <Border Grid.Row="0"
                BorderBrush="{StaticResource ControlBorderBrush}"
                BorderThickness="1">
            <Grid x:Name="SvGrid"
                  Height="170"
                  ClipToBounds="True"
                  MouseLeftButtonDown="SvMouseDown"
                  MouseMove="SvMouseMove"
                  MouseLeftButtonUp="SvMouseUp">
                <Rectangle x:Name="SvHueRect" Fill="Red" />
                <Rectangle x:Name="SvWhiteRect">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle x:Name="SvBlackRect">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#FF000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas x:Name="SvCursorLayer" ClipToBounds="True">
                    <Ellipse x:Name="SvCursor"
                             Width="12"
                             Height="12"
                             Stroke="#FFFFFFFF"
                             StrokeThickness="2"
                             Fill="#00000000" />
                </Canvas>
            </Grid>
        </Border>

        <!-- Hue -->
        <Border Grid.Row="1"
                Margin="0,8,0,0"
                Height="20"
                BorderBrush="{StaticResource ControlBorderBrush}"
                BorderThickness="1">
            <Grid x:Name="HueGrid"
                  ClipToBounds="True"
                  MouseLeftButtonDown="HueMouseDown"
                  MouseMove="HueMouseMove"
                  MouseLeftButtonUp="HueMouseUp">
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFF0000" Offset="0" />
                            <GradientStop Color="#FFFFFF00" Offset="0.1667" />
                            <GradientStop Color="#FF00FF00" Offset="0.3333" />
                            <GradientStop Color="#FF00FFFF" Offset="0.5" />
                            <GradientStop Color="#FF0000FF" Offset="0.6667" />
                            <GradientStop Color="#FFFF00FF" Offset="0.8333" />
                            <GradientStop Color="#FFFF0000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas x:Name="HueCursorLayer" ClipToBounds="True">
                    <Rectangle x:Name="HueCursor"
                               Width="5"
                               Height="20"
                               Fill="#FFFFFFFF"
                               Stroke="#FF000000"
                               StrokeThickness="1" />
                </Canvas>
            </Grid>
        </Border>

        <!-- Alpha -->
        <Border Grid.Row="2"
                Margin="0,6,0,0"
                Height="20"
                BorderBrush="{StaticResource ControlBorderBrush}"
                BorderThickness="1">
            <Grid x:Name="AlphaGrid"
                  ClipToBounds="True"
                  MouseLeftButtonDown="AlphaMouseDown"
                  MouseMove="AlphaMouseMove"
                  MouseLeftButtonUp="AlphaMouseUp">
                <Rectangle Fill="#FF6E6E74" />
                <Rectangle x:Name="AlphaGradientRect" />
                <Canvas x:Name="AlphaCursorLayer" ClipToBounds="True">
                    <Rectangle x:Name="AlphaCursor"
                               Width="5"
                               Height="20"
                               Fill="#FFFFFFFF"
                               Stroke="#FF000000"
                               StrokeThickness="1" />
                </Canvas>
            </Grid>
        </Border>

        <!-- Hex -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="#RRGGBB / #AARRGGBB" Style="{StaticResource SectionLabelStyle}" />
            <TextBox x:Name="HexBox"
                     Grid.Column="1"
                     VerticalContentAlignment="Center"
                     KeyDown="HexKeyDown"
                     LostFocus="HexLostFocus" />
            <Border x:Name="PreviewSwatch"
                    Grid.Column="2"
                    Width="28"
                    Height="20"
                    Margin="8,0,0,0"
                    BorderBrush="{StaticResource ControlBorderBrush}"
                    BorderThickness="1" />
            <TextBlock x:Name="AlphaText"
                       Grid.Column="3"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource SectionLabelStyle}" />
        </Grid>

        <TextBlock Grid.Row="4"
                   Text="Presets"
                   FontWeight="SemiBold"
                   Margin="0,12,0,4" />

        <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <WrapPanel x:Name="PresetPanel" />
        </ScrollViewer>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" MinWidth="84" IsCancel="True" Click="CancelClick" />
            <Button Content="OK" MinWidth="84" IsDefault="True" Style="{StaticResource AccentButtonStyle}" Click="OkClick" />
        </StackPanel>
    </Grid>
</Window>
