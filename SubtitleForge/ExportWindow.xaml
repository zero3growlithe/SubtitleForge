<Window x:Class="SubtitleForge.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export"
        Height="500"
        Width="540"
        MinHeight="440"
        MinWidth="480"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="What should the export contain?" FontWeight="SemiBold" Margin="0,0,0,10" />

        <StackPanel Grid.Row="1">
            <CheckBox x:Name="IncludeVideoCheck"
                      Content="Include video"
                      IsChecked="True"
                      Click="OptionChanged" />
            <CheckBox x:Name="IncludeAudioCheck"
                      Content="Include audio"
                      IsChecked="True"
                      Margin="0,6,0,0"
                      Click="OptionChanged" />
            <CheckBox x:Name="IncludeSubtitlesCheck"
                      Content="Include subtitles (as a separate file)"
                      Margin="0,6,0,0"
                      Click="OptionChanged" />
            <CheckBox x:Name="BurnSubtitlesCheck"
                      Content="Burn in subtitles"
                      Margin="0,6,0,0"
                      Click="OptionChanged" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="24,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Subtitle file format" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox x:Name="SubtitleFormatCombo" Grid.Column="1" SelectedIndex="0">
                <ComboBoxItem Content="SubRip (.srt)" Tag="srt" />
                <ComboBoxItem Content="WebVTT (.vtt)" Tag="vtt" />
                <ComboBoxItem Content="Advanced SubStation (.ass)" Tag="ass" />
            </ComboBox>
        </Grid>

        <Grid Grid.Row="3" Margin="24,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Backdrop colour" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox x:Name="BackgroundColorCombo" Grid.Column="1" SelectedIndex="0" SelectionChanged="BackgroundColorChanged">
                <ComboBoxItem Content="Chroma green (#00FF00)" Tag="0x00FF00" />
                <ComboBoxItem Content="Chroma blue (#0000FF)" Tag="0x0000FF" />
                <ComboBoxItem Content="Magenta (#FF00FF)" Tag="0xFF00FF" />
                <ComboBoxItem Content="Black (#000000)" Tag="0x000000" />
                <ComboBoxItem Content="White (#FFFFFF)" Tag="0xFFFFFF" />
                <ComboBoxItem Content="Grey (#808080)" Tag="0x808080" />
                <ComboBoxItem Content="Custom…" Tag="custom" />
            </ComboBox>
            <TextBox x:Name="CustomColorBox"
                     Grid.Column="2"
                     Width="96"
                     Margin="8,0,0,0"
                     VerticalContentAlignment="Center"
                     IsEnabled="False"
                     Text="0x00FF00"
                     ToolTip="Any ffmpeg colour, e.g. 0x00FF00" />
        </Grid>

        <TextBlock x:Name="HintText"
                   Grid.Row="4"
                   Margin="0,14,0,0"
                   TextWrapping="Wrap"
                   FontSize="11"
                   Foreground="{StaticResource SubtleTextBrush}" />

        <Border Grid.Row="6" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" MinWidth="90" IsCancel="True" Click="CancelClick" />
                <Button x:Name="ExportButton" Content="Export" MinWidth="90" IsDefault="True" Style="{StaticResource AccentButtonStyle}" Click="ExportClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
