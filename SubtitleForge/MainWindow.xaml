<Window x:Class="SubtitleForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SubtitleForge.Controls"
        Title="SubtitleForge"
        Height="840"
        Width="1340"
        MinHeight="640"
        MinWidth="1120"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="WindowPreviewKeyDown"
        Closing="WindowClosing">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Transcription toolbar ─────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="OpenVideoButton" Content="Open video…" Click="OpenVideoClick" />
            <Button x:Name="ImportSubtitlesButton" Content="Open subtitles…" Click="ImportSubtitlesClick" />
            <Rectangle Width="1" Margin="6,2,12,2" Fill="{StaticResource PanelBorderBrush}" />
            <Button x:Name="OpenProjectButton" Content="Open project…" Click="OpenProjectClick" />
            <Button x:Name="SaveProjectButton" Content="Save project" Click="SaveProjectClick" />
            <Button x:Name="SaveProjectAsButton" Content="Save as…" MinWidth="0" Padding="10,4" Click="SaveProjectAsClick" />
            <Rectangle Width="1" Margin="6,2,12,2" Fill="{StaticResource PanelBorderBrush}" />
            <TextBlock Text="Model" Style="{StaticResource SectionLabelStyle}" />
            <ComboBox x:Name="ModelComboBox" Width="232" SelectionChanged="ModelSelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayText}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button x:Name="ModelsButton" Content="Models…" MinWidth="0" Padding="10,4" Margin="0,0,12,0" Click="ModelsClick" />
            <Button x:Name="TextStyleButton" Content="Text style…" MinWidth="0" Padding="10,4" Margin="0,0,6,0" Click="TextStyleClick" />
            <Button x:Name="IdleProfileButton" Content="Idle anim…" MinWidth="0" Padding="10,4" Margin="0,0,6,0" Click="IdleProfileClick" />
            <Button x:Name="PopInProfileButton" Content="Pop-in…" MinWidth="0" Padding="10,4" Margin="0,0,12,0" Click="PopInProfileClick" />
            <TextBlock Text="Language" Style="{StaticResource SectionLabelStyle}" />
            <ComboBox x:Name="LanguageComboBox" Width="138" SelectionChanged="LanguageSelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Display}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <CheckBox x:Name="GpuCheckBox" Content="GPU (CUDA)" Checked="GpuCheckedChanged" />
            <CheckBox x:Name="TranslateCheckBox" Content="Translate → EN" />
            <Button x:Name="TranscribeButton" Content="Transcribe" Style="{StaticResource AccentButtonStyle}" Click="TranscribeClick" />
            <Button x:Name="CancelButton" Content="Cancel" Click="CancelClick" IsEnabled="False" />
        </StackPanel>

        <!-- ── Export toolbar ────────────────────────────────────────────── -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="ExportButton" Content="Export…" MinWidth="84" Click="ExportClick" />
            <Rectangle Width="1" Margin="6,2,12,2" Fill="{StaticResource PanelBorderBrush}" />
            <TextBlock Text="Max chars" Style="{StaticResource SectionLabelStyle}" />
            <TextBox x:Name="MaxCharactersTextBox" Width="46" Margin="0,0,12,0" />
            <TextBlock Text="Max sec" Style="{StaticResource SectionLabelStyle}" />
            <TextBox x:Name="MaxDurationTextBox" Width="46" Margin="0,0,12,0" />
            <TextBlock Text="Font size" Style="{StaticResource SectionLabelStyle}" />
            <TextBox x:Name="FontSizeTextBox" Width="42" Margin="0,0,12,0" />
            <TextBlock Text="Margin" Style="{StaticResource SectionLabelStyle}" />
            <TextBox x:Name="MarginTextBox" Width="46" Margin="0,0,0,0" />
        </StackPanel>

        <!-- ── Main content ──────────────────────────────────────────────── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="CuePanelColumn" Width="474" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="150" />
                    <RowDefinition Height="18" />
                    <RowDefinition x:Name="TimelineRow" Height="204" MinHeight="110" />
                </Grid.RowDefinitions>

                <!-- ── Preview, transport, cue strip and track toolbar ──────── -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="Black" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                    <Grid>
                        <!-- Muted for good: the sound you hear comes from the audio lanes only. -->
                        <MediaElement x:Name="VideoElement"
                                      LoadedBehavior="Manual"
                                      UnloadedBehavior="Manual"
                                      ScrubbingEnabled="True"
                                      IsMuted="True"
                                      Stretch="Uniform"
                                      MediaOpened="VideoMediaOpened"
                                      MediaEnded="VideoMediaEnded"
                                      MediaFailed="VideoMediaFailed" />
                        <TextBlock x:Name="EmptyHintText"
                                   Text="Open a video file to begin"
                                   FontSize="15"
                                   Foreground="#FF6E6E7A"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <controls:SubtitleOverlay x:Name="SubtitleOverlayView"
                                                  IsHitTestVisible="False"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PlayPauseButton" Grid.Column="0" Content="▶ Play" Width="88" Click="PlayPauseClick" />
                    <Button x:Name="StopButton" Grid.Column="1" Content="■ Stop" Width="74" Click="StopClick" />
                    <TextBlock x:Name="PositionText" Grid.Column="2" Text="00:00:00.000" FontFamily="Consolas" Margin="8,0,10,0" VerticalAlignment="Center" />
                    <Grid Grid.Column="3">
                        <Slider x:Name="PositionSlider"
                                Minimum="0"
                                Maximum="100"
                                Value="0"
                                IsMoveToPointEnabled="True"
                                ValueChanged="PositionSliderValueChanged" />
                        <Canvas x:Name="TimelineCanvas"
                                Height="18"
                                VerticalAlignment="Center"
                                ClipToBounds="True"
                                IsHitTestVisible="False"
                                SizeChanged="TimelineCanvasSizeChanged" />
                    </Grid>
                    <TextBlock x:Name="DurationText" Grid.Column="4" Text="00:00:00.000" FontFamily="Consolas" Margin="10,0,0,0" VerticalAlignment="Center" />
                </Grid>

                <!-- ── Track toolbar ─────────────────────────────────────── -->
                <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,6">
                    <Button x:Name="AddAudioTrackButton" Content="+ Audio track" Click="AddAudioTrackClick" />
                    <Button x:Name="RecordButton" Content="● Record" MinWidth="98" Click="RecordClick" />
                    <Button x:Name="SplitTrackButton" Content="Split at playhead" Click="SplitTrackClick" />
                    <Button x:Name="DeleteTrackButton" Content="Delete track" Click="DeleteTrackClick" />
                    <Button x:Name="RenameTrackButton" Content="Rename…" Click="RenameTrackClick" />
                    <Button x:Name="TrackColorButton" Content="Colour…" Click="TrackColorClick" />
                    <Button x:Name="UndoTrackButton" Content="Undo" MinWidth="0" Padding="10,4" Click="UndoClick" ToolTip="Ctrl+Z" />
                    <Button x:Name="RedoTrackButton" Content="Redo" MinWidth="0" Padding="10,4" Click="RedoClick" ToolTip="Ctrl+Y" />
                </WrapPanel>
                </Grid>

                <!-- ── Drag to trade height between the preview and the tracks ── -->
                <Border Grid.Row="1"
                        Width="58"
                        Height="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#FF3A3A42"
                        BorderBrush="#FF4A4A56"
                        BorderThickness="1"
                        CornerRadius="3"
                        IsHitTestVisible="False"
                        ToolTip="Drag to trade height between the preview and the tracks">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Ellipse Width="4" Height="4" Margin="3,0" Fill="#FF8A93A3" />
                        <Ellipse Width="4" Height="4" Margin="3,0" Fill="#FF8A93A3" />
                        <Ellipse Width="4" Height="4" Margin="3,0" Fill="#FF8A93A3" />
                    </StackPanel>
                </Border>
                <GridSplitter x:Name="PreviewSplitter"
                              Grid.Row="1"
                              Width="58"
                              Height="14"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              Background="Transparent"
                              ShowsPreview="False"
                              Cursor="SizeNS" />

                <!-- ── Multitrack timeline (waveforms + video thumbnails) ── -->
                <Border Grid.Row="2"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <controls:TrackTimeline x:Name="TrackTimelineView"
                                                TrackMouseDown="TrackTimelineMouseDown"
                                                SegmentMouseDown="TrackTimelineSegmentMouseDown"
                                                SegmentDropped="TrackTimelineSegmentDropped"
                                                AudioFilesDropped="TrackTimelineAudioFilesDropped"
                                                TrackReorderRequested="TrackTimelineReorder"
                                                TrackContextMenuRequested="TrackTimelineContextMenu"
                                                SeekRequested="TrackTimelineSeek" />
                    </ScrollViewer>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" />

            <!-- ── Cue editor panel ──────────────────────────────────────── -->
            <Grid Grid.Column="2" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="90" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="Cues" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="CueCountText" Text="0 cues" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" />
                </Grid>

                <!-- Global time offset: every cue plays and exports this many seconds away from
                     the times shown in the list. -->
                <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Time offset" Style="{StaticResource SectionLabelStyle}"
                               ToolTip="Shifts every cue on the timeline and in every export. The times in the list stay untouched." />
                    <controls:NumericDragBox x:Name="GlobalTimeOffsetBox"
                                             Width="72"
                                             Margin="0,0,6,0"
                                             Minimum="-600"
                                             Maximum="600"
                                             DragStep="0.01"
                                             Format="0.##"
                                             ToolTip="Seconds added to every cue when playing and exporting. Negative values make the subtitles earlier."
                                             ValueChanged="GlobalTimeOffsetChanged"
                                             LostFocus="GlobalTimeOffsetCommit" />
                    <TextBlock Text="s" Style="{StaticResource SectionLabelStyle}" />
                </WrapPanel>

                <ListView x:Name="CueList"
                          Grid.Row="1"
                          SelectionMode="Extended"
                          SelectionChanged="CueListSelectionChanged"
                          MouseDoubleClick="CueListMouseDoubleClick">
                    <ListView.View>
                        <GridView AllowsColumnReorder="False">
                            <!-- Cell templates instead of DisplayMemberBinding: the colour of a cue
                                 that overrides the look has to be set on the TextBlock itself, or
                                 the global TextBlock style wins over what the row inherits. -->
                            <GridViewColumn Header="#" Width="34">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding NumberDisplay}" Foreground="{Binding LabelBrush}"
                                                   FontWeight="{Binding LabelWeight}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Start" Width="86">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StartDisplay}" Foreground="{Binding LabelBrush}"
                                                   FontWeight="{Binding LabelWeight}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="End" Width="86">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding EndDisplay}" Foreground="{Binding LabelBrush}"
                                                   FontWeight="{Binding LabelWeight}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Text" Width="236">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TextPreview}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding LabelBrush}"
                                                   FontWeight="{Binding LabelWeight}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Start" Style="{StaticResource SectionLabelStyle}" />
                        <TextBox x:Name="StartEditor" Width="94" Margin="0,0,6,0" LostFocus="StartEditorLostFocus" KeyDown="TimeEditorKeyDown" />
                        <Button x:Name="SetStartButton" Content="= playhead" MinWidth="0" Padding="8,4" Margin="0,0,14,0" Click="SetStartClick" />
                        <TextBlock Text="End" Style="{StaticResource SectionLabelStyle}" />
                        <TextBox x:Name="EndEditor" Width="94" Margin="0,0,6,0" LostFocus="EndEditorLostFocus" KeyDown="TimeEditorKeyDown" />
                        <Button x:Name="SetEndButton" Content="= playhead" MinWidth="0" Padding="8,4" Margin="0,0,0,0" Click="SetEndClick" />
                    </WrapPanel>

                    <TextBox x:Name="CueTextEditor"
                             Grid.Row="1"
                             Height="78"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             TextChanged="CueTextEditorTextChanged"
                             GotFocus="CueTextEditorGotFocus"
                             LostFocus="CueTextEditorLostFocus" />

                    <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="NudgeBackButton" Content="-100 ms" MinWidth="0" Padding="8,4" Click="NudgeBackClick" />
                        <Button x:Name="NudgeForwardButton" Content="+100 ms" MinWidth="0" Padding="8,4" Click="NudgeForwardClick" />
                        <Button x:Name="SplitCueButton" Content="Split" MinWidth="0" Padding="8,4" Click="SplitCueClick" />
                        <Button x:Name="MergeCueButton" Content="Merge ↓" MinWidth="0" Padding="8,4" Click="MergeCueClick" />
                        <Button x:Name="AddCueButton" Content="+ New cue" MinWidth="0" Padding="8,4" Click="AddCueClick" />
                        <Button x:Name="DeleteCueButton" Content="Delete" MinWidth="0" Padding="8,4" Click="DeleteCueClick" />
                    </WrapPanel>

                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <WrapPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock Text="Style" Style="{StaticResource SectionLabelStyle}" />
                            <ComboBox x:Name="CueStyleCombo"
                                      Width="118"
                                      Margin="0,0,6,0"
                                      SelectionChanged="CueStyleSelectionChanged" />
                            <TextBlock Text="Idle" Style="{StaticResource SectionLabelStyle}" />
                            <ComboBox x:Name="CueIdleCombo"
                                      Width="118"
                                      Margin="0,0,6,0"
                                      SelectionChanged="CueIdleSelectionChanged" />
                            <TextBlock Text="Pop-in" Style="{StaticResource SectionLabelStyle}" />
                            <ComboBox x:Name="CuePopInCombo"
                                      Width="118"
                                      SelectionChanged="CuePopInSelectionChanged" />
                        </WrapPanel>

                        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Offset" Style="{StaticResource SectionLabelStyle}"
                                       ToolTip="How far this cue is moved away from the default subtitle position, in percent of the frame. 0 means the default." />
                            <TextBlock Text="X" Style="{StaticResource SectionLabelStyle}" />
                            <controls:NumericDragBox x:Name="CuePositionXBox"
                                                     Width="56"
                                                     Margin="0,0,6,0"
                                                     Minimum="-100"
                                                     Maximum="100"
                                                     DragStep="0.1"
                                                     Format="0.#"
                                                     ToolTip="Horizontal offset from the default position, in percent of the frame width (negative = left). 0 = the default."
                                                     ValueChanged="CuePlacementChanged"
                                                     LostFocus="CuePlacementCommit" />
                            <TextBlock Text="Y" Style="{StaticResource SectionLabelStyle}" />
                            <controls:NumericDragBox x:Name="CuePositionYBox"
                                                     Width="56"
                                                     Margin="0,0,6,0"
                                                     Minimum="-100"
                                                     Maximum="100"
                                                     DragStep="0.1"
                                                     Format="0.#"
                                                     ToolTip="Vertical offset from the default position, in percent of the frame height (negative = up). 0 = the default."
                                                     ValueChanged="CuePlacementChanged"
                                                     LostFocus="CuePlacementCommit" />
                            <TextBlock Text="Scale" Style="{StaticResource SectionLabelStyle}" />
                            <controls:NumericDragBox x:Name="CueScaleBox"
                                                     Width="56"
                                                     Margin="0,0,6,0"
                                                     Minimum="0.05"
                                                     Maximum="6"
                                                     DragStep="0.005"
                                                     Format="0.###"
                                                     ToolTip="Size multiplier. 1 = the size set in the text style profile."
                                                     ValueChanged="CuePlacementChanged"
                                                     LostFocus="CuePlacementCommit" />
                            <Button x:Name="CuePlacementResetButton"
                                    Content="Reset placement"
                                    MinWidth="0"
                                    Padding="8,4"
                                    Click="CuePlacementResetClick" />
                        </WrapPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- ── Status bar ────────────────────────────────────────────────── -->
        <Border Grid.Row="3"
                Margin="0,8,0,0"
                Padding="8,5"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1">
            <Grid Cursor="Hand" MouseLeftButtonUp="StatusBarClick" ToolTip="Background tasks — click for the list and progress">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="176" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="ProgressIndicator" Grid.Column="0" Minimum="0" Maximum="1" Value="0" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Margin="10,0,10,0" Text="Ready." VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="BackgroundTaskCountText"
                           Grid.Column="2"
                           Margin="0,0,10,0"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />
                <TextBlock x:Name="RuntimeText" Grid.Column="3" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" />
            </Grid>
        </Border>

        <Popup x:Name="BackgroundTasksPopup"
               PlacementTarget="{Binding ElementName=StatusText}"
               Placement="Top"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    Padding="12"
                    MinWidth="320">
                <StackPanel>
                    <TextBlock Text="Background tasks" FontWeight="Bold" Margin="0,0,0,6" />
                    <ItemsControl x:Name="BackgroundTasksList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <DockPanel LastChildFill="True">
                                        <!-- Only jobs that know how to stop show a Cancel button. -->
                                        <Button DockPanel.Dock="Right"
                                                Content="Cancel"
                                                Tag="{Binding}"
                                                MinWidth="0"
                                                Padding="8,2"
                                                Margin="8,0,0,0"
                                                Click="CancelBackgroundTaskClick">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanCancel}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                    <ProgressBar Value="{Binding Percent}"
                                                 IsIndeterminate="{Binding IsIndeterminate}"
                                                 Maximum="100"
                                                 Height="6"
                                                 Margin="0,3" />
                                    <TextBlock Text="{Binding Detail}"
                                               FontSize="11"
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoBackgroundTasksText"
                               Text="Nothing running right now."
                               Foreground="{StaticResource SubtleTextBrush}"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
