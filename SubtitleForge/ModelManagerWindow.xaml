<Window x:Class="SubtitleForge.ModelManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Whisper models"
        Height="520"
        Width="780"
        MinHeight="380"
        MinWidth="620"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Transcription models" FontWeight="SemiBold" Margin="0,0,0,4" />

        <TextBlock x:Name="PathText"
                   Grid.Row="1"
                   Margin="0,0,0,8"
                   FontSize="11"
                   Foreground="{StaticResource SubtleTextBrush}"
                   TextTrimming="CharacterEllipsis" />

        <ListView x:Name="ModelList" Grid.Row="2" SelectionMode="Single">
            <ListView.View>
                <GridView AllowsColumnReorder="False">
                    <GridViewColumn Header="Model" Width="240">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Download size" Width="110">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ApproximateText}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="On disk" Width="90">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SizeText}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Status" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusText}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="" Width="96">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Delete"
                                        MinWidth="0"
                                        Padding="10,2"
                                        Click="DeleteModelClick"
                                        IsEnabled="{Binding IsDownloaded}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="SummaryText"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource SubtleTextBrush}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Open folder" MinWidth="0" Padding="10,4" Click="OpenFolderClick" />
                <Button x:Name="DeleteAllButton" Content="Delete all" MinWidth="0" Padding="10,4" Click="DeleteAllClick" />
                <Button Content="Refresh" MinWidth="0" Padding="10,4" Click="RefreshClick" />
                <Button Content="Close" MinWidth="0" Padding="10,4" Margin="0" IsCancel="True" Style="{StaticResource AccentButtonStyle}" Click="CloseClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
