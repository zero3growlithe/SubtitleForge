<UserControl x:Class="SubtitleForge.Controls.ColorSpecPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal">
        <Button x:Name="StartButton"
                MinWidth="0"
                Padding="0"
                Height="24"
                Click="StartClick"
                ToolTip="Click to pick the first colour (hex entry is inside the picker)">
            <Border Width="44"
                    Height="16"
                    BorderBrush="{StaticResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="2">
                <Border x:Name="StartSwatch" />
            </Border>
        </Button>

        <Button x:Name="EndButton"
                MinWidth="0"
                Padding="0"
                Height="24"
                Margin="4,0,0,0"
                Click="EndClick"
                ToolTip="Click to pick the second colour of the gradient">
            <Border Width="44"
                    Height="16"
                    BorderBrush="{StaticResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="2">
                <Border x:Name="EndSwatch" />
            </Border>
        </Button>

        <Button x:Name="SwapButton"
                Content="⇄"
                MinWidth="0"
                Width="26"
                Padding="0"
                Height="24"
                Margin="4,0,0,0"
                Click="SwapClick"
                ToolTip="Swap the two colours" />

        <ComboBox x:Name="DirectionCombo"
                  Width="118"
                  Height="24"
                  Margin="6,0,0,0"
                  SelectionChanged="DirectionChanged">
            <ComboBoxItem Content="Solid" Tag="Solid" />
            <ComboBoxItem Content="Left → right" Tag="LeftToRight" />
            <ComboBoxItem Content="Right → left" Tag="RightToLeft" />
            <ComboBoxItem Content="Top → bottom" Tag="TopToBottom" />
            <ComboBoxItem Content="Bottom → top" Tag="BottomToTop" />
            <ComboBoxItem Content="↘ diagonal" Tag="DownRight" />
            <ComboBoxItem Content="↗ diagonal" Tag="UpRight" />
        </ComboBox>
    </StackPanel>
</UserControl>
