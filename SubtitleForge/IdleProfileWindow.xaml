<Window x:Class="SubtitleForge.IdleProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SubtitleForge.Controls"
        Title="Idle animation profile"
        Height="700"
        Width="880"
        MinHeight="560"
        MinWidth="760"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Profile" Style="{StaticResource SectionLabelStyle}" />
            <ComboBox x:Name="ProfileCombo" Grid.Column="1" SelectionChanged="ProfileSelectionChanged" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="New" MinWidth="0" Padding="10,4" Click="NewProfileClick" />
                <Button Content="Delete" MinWidth="0" Padding="10,4" Click="DeleteProfileClick" />
                <Button x:Name="DefaultButton" Content="Set as default" MinWidth="0" Padding="10,4" Click="SetDefaultClick" />
            </StackPanel>
        </Grid>

        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Name" Style="{StaticResource SectionLabelStyle}" />
            <TextBox x:Name="NameBox" Width="180" Margin="0,0,16,0" LostFocus="BasicsChanged" />
            <CheckBox x:Name="PerCharacterCheck"
                      Content="Animate separately"
                      Margin="0,0,10,0"
                      Click="BasicsChanged" />
            <TextBlock Text="per" Style="{StaticResource SectionLabelStyle}" />
            <ComboBox x:Name="StaggerGroupingCombo"
                      Width="126"
                      Height="24"
                      Margin="0,0,16,0"
                      SelectionChanged="BasicsChanged"
                      ToolTip="Character = a wave through the letters, word = each word out of phase, cue = the whole line moves together">
                <ComboBoxItem Content="character" Tag="Character" />
                <ComboBoxItem Content="word" Tag="Word" />
                <ComboBoxItem Content="whole cue" Tag="Cue" />
            </ComboBox>
            <TextBlock Text="Stagger (s)" Style="{StaticResource SectionLabelStyle}" />
            <controls:NumericDragBox x:Name="StaggerBox"
                                     Width="64"
                                     Minimum="0"
                                     Maximum="1"
                                     DragStep="0.005"
                                     Format="0.###"
                                     ToolTip="Delay between neighbours; drag to scrub, click to type"
                                     ValueChanged="BasicsChanged" />
        </WrapPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Channels" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock Text="Amplitude is a multiple of the font size for shake and sine, a scale delta for pulse (0.1 = ±10%), degrees for wiggle and rotations per second for spin."
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource SubtleTextBrush}"
                           Margin="0,0,0,8" />
                <StackPanel x:Name="ChannelPanel" />
            </StackPanel>
        </ScrollViewer>

<Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                <TextBlock Text="Preview size" Style="{StaticResource SectionLabelStyle}" />
                <controls:NumericDragBox x:Name="PreviewSizeBox"
                                         Width="64"
                                         Margin="0,0,8,0"
                                         Minimum="8"
                                         Maximum="400"
                                         DragStep="0.5"
                                         Format="0.#"
                                         ToolTip="Font size used by this preview only — it never touches the profile"
                                         ValueChanged="PreviewSizeChanged" />
                <TextBlock Text="used by the preview only; the profile keeps its own font size"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SubtleTextBrush}" />
            </WrapPanel>

            <Border Grid.Row="1" Height="250" Background="#FF14141A" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                <controls:SubtitleOverlay x:Name="PreviewOverlay" IsHitTestVisible="False" />
            </Border>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" MinWidth="90" IsCancel="True" Click="CancelClick" />
            <Button Content="Save profile" MinWidth="120" IsDefault="True" Style="{StaticResource AccentButtonStyle}" Click="SaveClick" />
        </StackPanel>
    </Grid>
</Window>
